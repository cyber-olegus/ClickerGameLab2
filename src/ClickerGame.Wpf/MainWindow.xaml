<Window x:Class="ClickerGame.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Игра-кликер — лабораторная № 2"
        Width="800" Height="520" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9">
    <Grid Margin="28">
        <Border Background="White" CornerRadius="14" Padding="28">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Игра-кликер" FontSize="32"
                           FontWeight="SemiBold" Foreground="#0F172A" />
                <TextBlock Margin="0,14,0,0" FontSize="17"
                           Foreground="#475569" TextWrapping="Wrap"
                           Text="Часть 1: основа приложения готова. Бой и улучшения появятся после подключения игровых классов." />
                <TextBlock Margin="0,20,0,0" FontSize="15"
                           Foreground="#475569" TextWrapping="Wrap"
                           Text="Для игры будут использоваться JSON и иконки из редактора противников лабораторной № 1." />
            </StackPanel>
        </Border>
    </Grid>
</Window>
