<Window x:Class="ClickerGame.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Игра-кликер — лабораторная № 2"
        Width="960" Height="740" MinWidth="760" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Stat" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,18" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Игра-кликер" FontSize="32" FontWeight="SemiBold" />
                <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}"
                           Text="Побеждайте противников, собирайте золото и улучшайте урон." />
            </StackPanel>
            <Border Grid.Row="1" Margin="0,20,0,20" Padding="18"
                    Background="White" CornerRadius="12">
                <StackPanel>
                    <WrapPanel>
                        <Button Content="Открыть JSON · новая игра" Click="LoadFile_Click" Margin="0,0,10,8" />
                        <Button x:Name="RestartButton" Content="Начать заново" Click="Restart_Click" Margin="0,0,0,8" />
                    </WrapPanel>
                    <TextBlock x:Name="SourceText" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="TemplateCountText" Margin="0,4,0,0" Style="{StaticResource Caption}" />
                </StackPanel>
            </Border>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Border Background="White" CornerRadius="12" Padding="22" Margin="0,0,18,0">
                    <StackPanel>
                        <TextBlock Text="ПРОТИВНИК" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="EnemyNameText" FontSize="25" FontWeight="SemiBold" Margin="0,8,0,14" />
                        <Button x:Name="AttackButton" Click="Attack_Click" Height="220" Background="#EEF2FF"
                                ToolTip="Нажмите, чтобы атаковать противника"
                                AutomationProperties.Name="Атаковать противника">
                            <Grid>
                                <Image x:Name="EnemyImage" Width="180" Height="180" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                <TextBlock x:Name="IconPlaceholder" Text="?" FontSize="72"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                        <TextBlock x:Name="IconHintText" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                        <TextBlock Text="Нажимайте на изображение, чтобы нанести урон." Style="{StaticResource Caption}" Margin="0,8,0,18" />
                        <TextBlock Text="Здоровье" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="EnemyHealthText" Style="{StaticResource Stat}" />
                        <TextBlock Text="Награда за победу" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="EnemyRewardText" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="22">
                    <StackPanel>
                        <TextBlock Text="ИГРОК" Style="{StaticResource Caption}" Margin="0,0,0,16" />
                        <TextBlock Text="Золото" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="GoldText" Style="{StaticResource Stat}" Foreground="#B45309" />
                        <TextBlock Text="Урон за клик" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="DamageText" Style="{StaticResource Stat}" />
                        <TextBlock Text="Уровень" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="LevelText" Style="{StaticResource Stat}" />
                        <TextBlock Text="Победы" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="VictoriesText" Style="{StaticResource Stat}" />
                        <TextBlock Text="Цена следующего улучшения" Style="{StaticResource Caption}" />
                        <TextBlock x:Name="UpgradeCostText" Style="{StaticResource Stat}" />
                        <Button x:Name="UpgradeButton" Content="Улучшить урон" Click="Upgrade_Click"
                                Background="#4F46E5" Foreground="White" />
                        <TextBlock Text="Кнопка доступна, когда хватает золота." Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border Grid.Row="3" Background="#E0E7FF" CornerRadius="12" Padding="16" Margin="0,20,0,0">
                <TextBlock x:Name="StatusText" FontSize="15" Foreground="#312E81" />
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
